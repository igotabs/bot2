# --- Telegram (REQUIRED) ---------------------------------------------------- #
# Get a fresh token from @BotFather. NEVER commit the real value.
BOT_TOKEN=7634098743:AAGEWXhnVZqGpqtgpowbj5j5a6b8X-uicWg

# --- UI texts source -------------------------------------------------------- #
CONFIG_FILE=./secret.xlsx

# --- Storage / behaviour ---------------------------------------------------- #
EXCEL_PATH=C:/Users/oleg/OneDrive - ФІЗИЧНА ОСОБА-ПІДПРИЄМЕЦЬ СТЕБЛЄВ ОЛЕГ ІГОРОВИЧ/night/reports.xlsx
QUEUE_PATH=./failed_reports.json
MEDIA_DIR=./media
SAVE_MEDIA_FILES=1
RATE_LIMIT_MINUTES=15
DUPLICATE_WINDOW_HOURS=24
LOG_LEVEL=INFO

# --- Admin notifications ---------------------------------------------------- #
# The bot notifies this recipient about every new / changed record.
# RECOMMENDED: numeric chat id (send /myid to the bot to get it). The admin must
# have pressed Start in the bot at least once.
NOTIFY_CHAT_ID=5810251318
# Fallback public @username (works reliably only for public channels/groups).
NOTIFY_USERNAME=@igotab
# Where the "already-notified" identities are persisted (new vs changed).
NOTIFY_SEEN_PATH=./notified_ids.json

# --- SharePoint / OneDrive upload (OPTIONAL) -------------------------------- #
# Leave blank to store reports.xlsx locally only. Fill in to auto-upload to the
# shared folder via Microsoft Graph (app registration with Files.ReadWrite.All).
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_FOLDER_URL=
SHAREPOINT_FILE_NAME=reports.xlsx
